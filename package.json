{
  "name": "dsh-browser-sidepanel",
  "version": "0.1.0",
  "type": "module",
  "description": "A real browser for the DeepSeek Harness Web GUI right sidebar: CDP-driven Chrome, not an iframe, with element picking into context and 7 agent tools. Unlike the Browser that ships with DSH — a sandboxed iframe that is off by default in Web profiles — this one is built for the Web UI.",
  "license": "MIT",
  "author": "Arunat-25",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arunat-25/dsh-browser-sidepanel.git"
  },
  "homepage": "https://github.com/Arunat-25/dsh-browser-sidepanel#readme",
  "bugs": {
    "url": "https://github.com/Arunat-25/dsh-browser-sidepanel/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "sidepanel",
    "web-ui",
    "cdp",
    "chrome-devtools-protocol",
    "element-picking",
    "agent-tools"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node tools/host-selftest.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}